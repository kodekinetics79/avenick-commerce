generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum UserRole {
  CONSUMER
  COMPANY_ADMIN
  COMPANY_BUYER
  COMPANY_APPROVER
  SELLER_OWNER
  SELLER_STAFF
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
}

enum Language {
  AR
  EN
}

enum Country {
  AE
  SA
  QA
  KW
  OM
  BH
}

enum Currency {
  AED
  SAR
  QAR
  KWD
  OMR
  BHD
  USD
}

enum Industry {
  INDUSTRIAL_SUPPLIES
  ELECTRONICS
  OFFICE_SUPPLIES
  SAFETY_PPE
  FOOD_HOSPITALITY
  BUILDING_MATERIALS
  HEALTHCARE
  RETAIL
  MANUFACTURING
  TECHNOLOGY
  OTHER
}

enum CompanySize {
  MICRO
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

enum CompanyStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum SellerType {
  MANUFACTURER
  DISTRIBUTOR
  IMPORTER
  RETAILER
}

enum SellerTier {
  STANDARD
  VERIFIED
  GOLD
  PLATINUM
}

enum SellerStatus {
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  REJECTED
}

enum DocumentType {
  COMMERCIAL_REGISTRATION
  TRADE_LICENSE
  VAT_CERTIFICATE
  SASO_CERTIFICATE
  SFDA_APPROVAL
  HALAL_CERTIFICATE
  ESMA_CERTIFICATE
  ISO_CERTIFICATE
  OTHER
}

enum DocumentStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUPPRESSED
  SUSPENDED
  REJECTED
  INACTIVE
}

enum PricingType {
  B2B
  B2C
}

enum OrderType {
  B2C
  B2B
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_CONFIRMED
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_PAID
  REFUNDED
  FAILED
}

enum PaymentMethod {
  MADA
  APPLE_PAY
  CREDIT_CARD
  BANK_TRANSFER
  STC_PAY
  MOCK
}

enum FulfillmentType {
  SELLER_FULFILLED
  PLATFORM_FULFILLED
  THIRD_PARTY_3PL
}

enum WarehouseType {
  SELLER
  PLATFORM
  THIRD_PARTY_3PL
}

enum POStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
  ORDERED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum RFQStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  QUOTED
  NEGOTIATING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum MessageSenderType {
  BUYER
  SELLER
  ADMIN
  SYSTEM
}

enum NotificationType {
  ORDER_UPDATE
  PAYMENT
  COMPLIANCE
  SYSTEM
  RFQ
  INVENTORY
  PAYOUT
  MESSAGE
}

enum ProductIssueType {
  MISSING_IMAGES
  MISSING_ARABIC_TITLE
  MISSING_ARABIC_DESCRIPTION
  MISSING_ENGLISH_TITLE
  MISSING_ENGLISH_DESCRIPTION
  NO_PRICE
  NO_STOCK
  MISSING_COMPLIANCE
  REJECTED_BY_ADMIN
  INACTIVE_STATUS
  CATEGORY_ISSUE
  SKU_DUPLICATE
  SUPPRESSED
}

enum IssueSeverity {
  INFO
  WARNING
  ERROR
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  SUSPEND
  ACTIVATE
  LOGIN
  LOGOUT
  PRICE_CHANGE
  STATUS_CHANGE
}

enum InventoryMovementType {
  IN
  OUT
  ADJUSTMENT
  RESERVE
  RELEASE
}

enum RefundStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

// ─── USER & SESSION ───────────────────────────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  phone         String?    @unique
  passwordHash  String?
  firstName     String
  lastName      String
  firstNameAr   String?
  lastNameAr    String?
  avatar        String?
  role          UserRole
  status        UserStatus @default(PENDING)
  emailVerified DateTime?
  phoneVerified DateTime?
  language      Language   @default(AR)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  sellerProfile      SellerProfile?
  adminProfile       AdminProfile?
  companyMember      CompanyMember?
  addresses          Address[]
  cart               Cart?
  orders             Order[]
  sessions           Session[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  sentMessages       Message[]          @relation("SentMessages")
  customerActivities CustomerActivity[]

  @@index([email])
  @@index([role, status])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AdminProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ─── B2B COMPANY ──────────────────────────────────────────────────────────────

model Company {
  id           String        @id @default(cuid())
  nameEn       String
  nameAr       String?
  crNumber     String?       @unique
  vatNumber    String?       @unique
  industry     Industry
  size         CompanySize
  country      Country
  city         String
  logo         String?
  status       CompanyStatus @default(PENDING_VERIFICATION)
  creditLimit  Decimal?      @db.Decimal(12, 2)
  paymentTerms Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  members          CompanyMember[]
  addresses        Address[]
  orders           Order[]
  purchaseOrders   PurchaseOrder[]
  approvalPolicies ApprovalPolicy[]
  rfqRequests      RFQRequest[]

  @@index([status])
  @@index([country])
}

model CompanyMember {
  id         String   @id @default(cuid())
  userId     String   @unique
  companyId  String
  role       UserRole
  department String?
  spendLimit Decimal? @db.Decimal(12, 2)
  isActive   Boolean  @default(true)
  joinedAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model ApprovalPolicy {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  thresholdAmount Decimal  @db.Decimal(12, 2)
  currency        Currency @default(AED)
  approverRole    UserRole
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model PurchaseOrder {
  id              String    @id @default(cuid())
  poNumber        String    @unique
  companyId       String
  requesterId     String
  approverId      String?
  status          POStatus  @default(DRAFT)
  currency        Currency  @default(AED)
  total           Decimal   @db.Decimal(12, 2)
  requiredDate    DateTime?
  notes           String?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  orders  Order[]

  @@index([companyId, status])
  @@index([requesterId])
  @@index([approverId])
}

// ─── SELLER ───────────────────────────────────────────────────────────────────

model SellerProfile {
  id             String       @id @default(cuid())
  userId         String       @unique
  businessNameEn String
  businessNameAr String?
  crNumber       String       @unique
  vatNumber      String?
  type           SellerType
  country        Country
  city           String
  description    String?      @db.Text
  descriptionAr  String?      @db.Text
  logo           String?
  banner         String?
  tier           SellerTier   @default(STANDARD)
  status         SellerStatus @default(PENDING_REVIEW)
  commissionRate Decimal      @default(5.00) @db.Decimal(5, 2)
  bankDetails    Json?
  rating         Decimal?     @db.Decimal(3, 2)
  reviewCount    Int          @default(0)
  accountHealth  Int          @default(100)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  user            User             @relation(fields: [userId], references: [id])
  products        Product[]
  documents       SellerDocument[]
  payouts         SellerPayout[]
  warehouses      Warehouse[]
  rfqRequests     RFQRequest[]
  messageThreads  MessageThread[]
  sellerCustomers SellerCustomer[]
  commissions     Commission[]
  auditLogs       AuditLog[]

  @@index([status])
  @@index([country])
}

model SellerDocument {
  id              String         @id @default(cuid())
  sellerId        String
  type            DocumentType
  fileUrl         String
  fileName        String
  fileSize        Int?
  mimeType        String?
  status          DocumentStatus @default(PENDING_REVIEW)
  expiryDate      DateTime?
  rejectionReason String?
  uploadedAt      DateTime       @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?

  seller SellerProfile @relation(fields: [sellerId], references: [id])

  @@index([sellerId, status])
  @@index([expiryDate])
}

model SellerPayout {
  id          String       @id @default(cuid())
  sellerId    String
  amount      Decimal      @db.Decimal(12, 2)
  currency    Currency
  status      PayoutStatus @default(PENDING)
  reference   String?
  periodFrom  DateTime
  periodTo    DateTime
  processedAt DateTime?
  notes       String?
  createdAt   DateTime     @default(now())

  seller SellerProfile      @relation(fields: [sellerId], references: [id])
  items  SellerPayoutItem[]

  @@index([sellerId, status])
}

model SellerPayoutItem {
  id         String  @id @default(cuid())
  payoutId   String
  orderId    String
  amount     Decimal @db.Decimal(12, 2)
  commission Decimal @db.Decimal(12, 2)
  net        Decimal @db.Decimal(12, 2)

  payout SellerPayout @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  order  Order        @relation(fields: [orderId], references: [id])

  @@index([payoutId])
  @@index([orderId])
}

// ─── CATALOG ──────────────────────────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  nameEn    String
  nameAr    String
  slug      String   @unique
  parentId  String?
  imageUrl  String?
  iconName  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([slug])
  @@index([parentId])
}

model Brand {
  id        String   @id @default(cuid())
  nameEn    String
  nameAr    String?
  slug      String   @unique
  logoUrl   String?
  country   Country?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  products Product[]

  @@index([slug])
}

model Product {
  id            String        @id @default(cuid())
  sellerId      String
  categoryId    String
  brandId       String?
  sku           String        @unique
  slug          String        @unique
  nameEn        String
  nameAr        String
  descriptionEn String?       @db.Text
  descriptionAr String?       @db.Text
  status        ProductStatus @default(DRAFT)
  isB2CEnabled  Boolean       @default(false)
  isB2BEnabled  Boolean       @default(true)
  origin        Country?
  weight        Decimal?      @db.Decimal(10, 3)
  dimensions    Json?
  tags          String[]
  moq           Int           @default(1)
  listingHealth Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  publishedAt   DateTime?

  seller      SellerProfile               @relation(fields: [sellerId], references: [id])
  category    Category                    @relation(fields: [categoryId], references: [id])
  brand       Brand?                      @relation(fields: [brandId], references: [id])
  images      ProductImage[]
  variants    ProductVariant[]
  prices      ProductPrice[]
  compliance  ProductComplianceDocument[]
  issues      ProductIssue[]
  healthSnaps ListingHealthSnapshot[]
  orderItems  OrderItem[]
  cartItems   CartItem[]
  inventory   InventoryStock[]
  rfqItems    RFQItem[]

  @@index([sellerId, status])
  @@index([categoryId])
  @@index([brandId])
  @@index([slug])
  @@index([sku])
  @@index([deletedAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  altEn     String?
  altAr     String?
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  sku        String  @unique
  nameEn     String
  nameAr     String?
  attributes Json
  isActive   Boolean @default(true)

  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  prices    ProductPrice[]
  inventory InventoryStock[]

  @@index([productId])
}

model ProductPrice {
  id        String      @id @default(cuid())
  productId String?
  variantId String?
  type      PricingType
  currency  Currency    @default(AED)
  minQty    Int         @default(1)
  maxQty    Int?
  price     Decimal     @db.Decimal(12, 2)
  vatRate   Decimal     @default(5.00) @db.Decimal(5, 2)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())

  product Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId, type, currency])
  @@index([variantId])
}

model ProductComplianceDocument {
  id              String         @id @default(cuid())
  productId       String
  sellerId        String
  type            DocumentType
  fileUrl         String
  fileName        String
  issuingBody     String?
  certificateNo   String?
  validFrom       DateTime?
  validUntil      DateTime?
  countries       Country[]
  status          DocumentStatus @default(PENDING_REVIEW)
  rejectionReason String?
  createdAt       DateTime       @default(now())
  reviewedAt      DateTime?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, status])
  @@index([sellerId])
}

model ProductIssue {
  id         String           @id @default(cuid())
  productId  String
  issueType  ProductIssueType
  severity   IssueSeverity    @default(WARNING)
  message    String
  messageAr  String?
  resolvedAt DateTime?
  createdAt  DateTime         @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, resolvedAt])
}

model ListingHealthSnapshot {
  id             String   @id @default(cuid())
  productId      String
  score          Int
  hasImages      Boolean
  hasArabicTitle Boolean
  hasArabicDesc  Boolean
  hasPrice       Boolean
  hasStock       Boolean
  hasCompliance  Boolean
  isApproved     Boolean
  hasBrand       Boolean
  capturedAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, capturedAt])
}

// ─── WAREHOUSE / INVENTORY ────────────────────────────────────────────────────

model Warehouse {
  id        String        @id @default(cuid())
  sellerId  String?
  nameEn    String
  nameAr    String?
  type      WarehouseType
  country   Country
  city      String
  address   String?
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  seller    SellerProfile?      @relation(fields: [sellerId], references: [id])
  locations InventoryLocation[]

  @@index([sellerId])
}

model InventoryLocation {
  id          String  @id @default(cuid())
  warehouseId String
  code        String
  zone        String?
  aisle       String?
  bin         String?
  isActive    Boolean @default(true)

  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  stock     InventoryStock[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
}

model InventoryStock {
  id           String   @id @default(cuid())
  productId    String?
  variantId    String?
  locationId   String
  qty          Int      @default(0)
  reservedQty  Int      @default(0)
  reorderPoint Int      @default(10)
  updatedAt    DateTime @updatedAt

  product   Product?            @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location  InventoryLocation   @relation(fields: [locationId], references: [id])
  movements InventoryMovement[]

  @@index([productId])
  @@index([variantId])
  @@index([locationId])
}

model InventoryMovement {
  id        String                @id @default(cuid())
  stockId   String
  type      InventoryMovementType
  qty       Int
  reference String?
  notes     String?
  createdBy String?
  createdAt DateTime              @default(now())

  stock InventoryStock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@index([stockId])
  @@index([createdAt])
}

// ─── CART ─────────────────────────────────────────────────────────────────────

model Cart {
  id        String   @id @default(cuid())
  userId    String?  @unique
  sessionId String?  @unique
  currency  Currency @default(AED)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user  User?      @relation(fields: [userId], references: [id])
  items CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  qty       Int
  priceAED  Decimal  @db.Decimal(12, 2)
  addedAt   DateTime @default(now())

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@index([productId])
}

// ─── ADDRESS & ORDER ──────────────────────────────────────────────────────────

model Address {
  id         String   @id @default(cuid())
  userId     String?
  companyId  String?
  label      String
  line1      String
  line2      String?
  city       String
  country    Country
  postalCode String?
  lat        Decimal? @db.Decimal(10, 8)
  lng        Decimal? @db.Decimal(11, 8)
  isDefault  Boolean  @default(false)

  user    User?    @relation(fields: [userId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])
  orders  Order[]

  @@index([userId])
  @@index([companyId])
}

model Order {
  id              String          @id @default(cuid())
  orderNumber     String          @unique
  userId          String
  companyId       String?
  purchaseOrderId String?
  addressId       String?
  type            OrderType
  status          OrderStatus     @default(PENDING_PAYMENT)
  fulfillment     FulfillmentType @default(SELLER_FULFILLED)
  currency        Currency        @default(AED)
  subtotal        Decimal         @db.Decimal(12, 2)
  vatAmount       Decimal         @db.Decimal(12, 2)
  shippingAmount  Decimal         @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal         @default(0) @db.Decimal(12, 2)
  total           Decimal         @db.Decimal(12, 2)
  paymentMethod   PaymentMethod?
  paymentStatus   PaymentStatus   @default(UNPAID)
  shippingAddress Json
  notes           String?
  vatInvoiceUrl   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user          User                 @relation(fields: [userId], references: [id])
  company       Company?             @relation(fields: [companyId], references: [id])
  purchaseOrder PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id])
  address       Address?             @relation(fields: [addressId], references: [id])
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  payments      Payment[]
  commissions   Commission[]
  payoutItems   SellerPayoutItem[]
  refunds       Refund[]
  taxInvoice    TaxInvoice?

  @@index([userId, status])
  @@index([companyId])
  @@index([purchaseOrderId])
  @@index([addressId])
  @@index([orderNumber])
  @@index([createdAt])
}

model OrderItem {
  id        String      @id @default(cuid())
  orderId   String
  productId String
  variantId String?
  sellerId  String
  sku       String
  nameEn    String
  nameAr    String
  quantity  Int
  unitPrice Decimal     @db.Decimal(12, 2)
  vatRate   Decimal     @default(5.00) @db.Decimal(5, 2)
  vatAmount Decimal     @db.Decimal(12, 2)
  total     Decimal     @db.Decimal(12, 2)
  status    OrderStatus @default(CONFIRMED)
  createdAt DateTime    @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([sellerId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  message   String?
  messageAr String?
  actorId   String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ─── PAYMENT / FINANCE ────────────────────────────────────────────────────────

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  method      PaymentMethod
  status      PaymentStatus @default(UNPAID)
  amount      Decimal       @db.Decimal(12, 2)
  currency    Currency
  gatewayRef  String?
  gatewayData Json?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Refund {
  id          String       @id @default(cuid())
  orderId     String
  amount      Decimal      @db.Decimal(12, 2)
  reason      String?
  status      RefundStatus @default(PENDING)
  processedAt DateTime?
  createdAt   DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Commission {
  id        String    @id @default(cuid())
  sellerId  String
  orderId   String
  amount    Decimal   @db.Decimal(12, 2)
  rate      Decimal   @db.Decimal(5, 2)
  currency  Currency
  settledAt DateTime?
  createdAt DateTime  @default(now())

  seller SellerProfile @relation(fields: [sellerId], references: [id])
  order  Order         @relation(fields: [orderId], references: [id])

  @@index([sellerId])
  @@index([orderId])
}

model TaxInvoice {
  id          String   @id @default(cuid())
  orderId     String   @unique
  invoiceNo   String   @unique
  fileUrl     String?
  issuedAt    DateTime @default(now())
  totalAmount Decimal  @db.Decimal(12, 2)
  vatAmount   Decimal  @db.Decimal(12, 2)
  currency    Currency

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ─── RFQ ──────────────────────────────────────────────────────────────────────

model RFQRequest {
  id          String    @id @default(cuid())
  rfqNumber   String    @unique
  buyerId     String
  companyId   String?
  sellerId    String?
  status      RFQStatus @default(DRAFT)
  currency    Currency  @default(AED)
  notes       String?
  totalQuoted Decimal?  @db.Decimal(12, 2)
  requiredBy  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company  Company?       @relation(fields: [companyId], references: [id])
  seller   SellerProfile? @relation(fields: [sellerId], references: [id])
  items    RFQItem[]
  messages Message[]

  @@index([buyerId, status])
  @@index([sellerId, status])
}

model RFQItem {
  id         String   @id @default(cuid())
  rfqId      String
  productId  String?
  nameEn     String
  quantity   Int
  unitQuoted Decimal? @db.Decimal(12, 2)
  notes      String?

  rfq     RFQRequest @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  product Product?   @relation(fields: [productId], references: [id])

  @@index([rfqId])
  @@index([productId])
}

// ─── MESSAGING ────────────────────────────────────────────────────────────────

model MessageThread {
  id        String   @id @default(cuid())
  sellerId  String
  buyerId   String
  rfqId     String?
  orderId   String?
  subject   String?
  isOpen    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller   SellerProfile @relation(fields: [sellerId], references: [id])
  messages Message[]

  @@index([sellerId])
  @@index([buyerId])
}

model Message {
  id          String            @id @default(cuid())
  threadId    String?
  rfqId       String?
  senderId    String
  senderType  MessageSenderType
  body        String            @db.Text
  attachments String[]
  isRead      Boolean           @default(false)
  readAt      DateTime?
  createdAt   DateTime          @default(now())

  thread MessageThread? @relation(fields: [threadId], references: [id])
  rfq    RFQRequest?    @relation(fields: [rfqId], references: [id])
  sender User           @relation("SentMessages", fields: [senderId], references: [id])

  @@index([threadId])
  @@index([rfqId])
  @@index([senderId])
}

// ─── CRM ──────────────────────────────────────────────────────────────────────

model SellerCustomer {
  id          String    @id @default(cuid())
  sellerId    String
  buyerId     String
  totalOrders Int       @default(0)
  totalSpent  Decimal   @default(0) @db.Decimal(12, 2)
  currency    Currency  @default(AED)
  lastOrderAt DateTime?
  tags        String[]
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  seller     SellerProfile      @relation(fields: [sellerId], references: [id])
  activities CustomerActivity[]

  @@unique([sellerId, buyerId])
  @@index([sellerId])
}

model CustomerActivity {
  id               String   @id @default(cuid())
  sellerCustomerId String?
  buyerId          String
  type             String
  productId        String?
  orderId          String?
  metadata         Json?
  createdAt        DateTime @default(now())

  sellerCustomer SellerCustomer? @relation(fields: [sellerCustomerId], references: [id])
  buyer          User            @relation(fields: [buyerId], references: [id])

  @@index([buyerId])
  @@index([sellerCustomerId])
}

// ─── NOTIFICATIONS & AUDIT ────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  titleEn   String
  titleAr   String?
  bodyEn    String
  bodyAr    String?
  isRead    Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  sellerId   String?
  entityType String
  entityId   String
  action     AuditAction
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  actor  User?          @relation(fields: [actorId], references: [id])
  seller SellerProfile? @relation(fields: [sellerId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}
