generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; rhel-openssl-3.0.x is the Vercel serverless runtime.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum UserRole {
  CONSUMER
  COMPANY_ADMIN
  COMPANY_BUYER
  COMPANY_APPROVER
  SELLER_OWNER
  SELLER_STAFF
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
}

enum Language {
  AR
  EN
}

enum Country {
  AE
  SA
  QA
  KW
  OM
  BH
}

enum Currency {
  AED
  SAR
  QAR
  KWD
  OMR
  BHD
  USD
}

enum Industry {
  INDUSTRIAL_SUPPLIES
  ELECTRONICS
  OFFICE_SUPPLIES
  SAFETY_PPE
  FOOD_HOSPITALITY
  BUILDING_MATERIALS
  HEALTHCARE
  RETAIL
  MANUFACTURING
  TECHNOLOGY
  OTHER
}

enum CompanySize {
  MICRO
  SMALL
  MEDIUM
  LARGE
  ENTERPRISE
}

enum CompanyStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum SellerType {
  MANUFACTURER
  DISTRIBUTOR
  IMPORTER
  RETAILER
}

enum SellerTier {
  STANDARD
  VERIFIED
  GOLD
  PLATINUM
}

enum SellerStatus {
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  REJECTED
}

enum DocumentType {
  COMMERCIAL_REGISTRATION
  TRADE_LICENSE
  VAT_CERTIFICATE
  SASO_CERTIFICATE
  SFDA_APPROVAL
  HALAL_CERTIFICATE
  ESMA_CERTIFICATE
  ISO_CERTIFICATE
  OTHER
}

enum DocumentStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum ProductStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUPPRESSED
  SUSPENDED
  REJECTED
  INACTIVE
}

enum PricingType {
  B2B
  B2C
}

enum OrderType {
  B2C
  B2B
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_CONFIRMED
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_PAID
  REFUNDED
  FAILED
}

enum PaymentMethod {
  MADA
  APPLE_PAY
  CREDIT_CARD
  BANK_TRANSFER
  STC_PAY
  MOCK
}

enum FulfillmentType {
  SELLER_FULFILLED
  PLATFORM_FULFILLED
  THIRD_PARTY_3PL
}

enum WarehouseType {
  SELLER
  PLATFORM
  THIRD_PARTY_3PL
}

enum POStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PLACING
  REJECTED
  CANCELLED
  ORDERED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum RFQStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  QUOTED
  NEGOTIATING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum MessageSenderType {
  BUYER
  SELLER
  ADMIN
  SYSTEM
}

enum NotificationType {
  ORDER_UPDATE
  PAYMENT
  COMPLIANCE
  SYSTEM
  RFQ
  INVENTORY
  PAYOUT
  MESSAGE
}

enum ProductIssueType {
  MISSING_IMAGES
  MISSING_ARABIC_TITLE
  MISSING_ARABIC_DESCRIPTION
  MISSING_ENGLISH_TITLE
  MISSING_ENGLISH_DESCRIPTION
  NO_PRICE
  NO_STOCK
  MISSING_COMPLIANCE
  REJECTED_BY_ADMIN
  INACTIVE_STATUS
  CATEGORY_ISSUE
  SKU_DUPLICATE
  SUPPRESSED
}

enum IssueSeverity {
  INFO
  WARNING
  ERROR
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  SUSPEND
  ACTIVATE
  LOGIN
  LOGOUT
  PRICE_CHANGE
  STATUS_CHANGE
}

enum InventoryMovementType {
  IN
  OUT
  ADJUSTMENT
  RESERVE
  RELEASE
}

enum RefundStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
}

enum SellerFinancialAdjustmentStatus {
  OPEN
  APPLIED
}

enum SupportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ShipmentStatus {
  PENDING
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  IN_TRANSIT
  RECEIVED
  REFUNDED
}

// ─── USER & SESSION ───────────────────────────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  phone         String?    @unique
  passwordHash  String?
  firstName     String
  lastName      String
  firstNameAr   String?
  lastNameAr    String?
  avatar        String?
  role          UserRole
  status        UserStatus @default(PENDING)
  emailVerified DateTime?
  phoneVerified DateTime?
  language      Language   @default(AR)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  sellerProfile      SellerProfile?
  adminProfile       AdminProfile?
  companyMember      CompanyMember?
  addresses          Address[]
  cart               Cart?
  orders             Order[]
  sessions           Session[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  sentMessages       Message[]          @relation("SentMessages")
  customerActivities CustomerActivity[]
  reviews            ProductReview[]
  supportTickets     SupportTicket[]
  sellerMemberships SellerMembership[]

  @@index([email])
  @@index([role, status])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AdminProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ─── B2B COMPANY ──────────────────────────────────────────────────────────────

model Company {
  id           String        @id @default(cuid())
  nameEn       String
  nameAr       String?
  crNumber     String?       @unique
  vatNumber    String?       @unique
  industry     Industry
  size         CompanySize
  country      Country
  city         String
  logo         String?
  status       CompanyStatus @default(PENDING_VERIFICATION)
  creditLimit  Decimal?      @db.Decimal(12, 2)
  paymentTerms Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  members          CompanyMember[]
  addresses        Address[]
  orders           Order[]
  purchaseOrders   PurchaseOrder[]
  approvalPolicies ApprovalPolicy[]
  rfqRequests      RFQRequest[]
  requisitionLists RequisitionList[]
  externalAccountLinks ExternalAccountLink[]
  integrationRoutes IntegrationCompanyRoute[]

  @@index([status])
  @@index([country])
}

model CompanyMember {
  id         String   @id @default(cuid())
  userId     String   @unique
  companyId  String
  role       UserRole
  department String?
  spendLimit Decimal? @db.Decimal(12, 2)
  isActive   Boolean  @default(true)
  joinedAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model ApprovalPolicy {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  thresholdAmount Decimal  @db.Decimal(12, 2)
  currency        Currency @default(AED)
  approverRole    UserRole
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
}

model PurchaseOrder {
  id              String    @id @default(cuid())
  poNumber        String    @unique
  companyId       String
  requesterId     String
  approverId      String?
  status          POStatus  @default(DRAFT)
  currency        Currency  @default(AED)
  total           Decimal   @db.Decimal(12, 2)
  requiredDate    DateTime?
  notes           String?
  rejectionReason String?
  approvalSnapshot Json?
  approvedCommercialFingerprint String? @db.Text
  approvalVersion Int       @default(0)
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  orders  Order[]
  items   PurchaseOrderItem[]

  @@index([companyId, status])
  @@index([requesterId])
  @@index([approverId])
}

// ─── SELLER ───────────────────────────────────────────────────────────────────

model SellerProfile {
  id             String       @id @default(cuid())
  userId         String       @unique
  businessNameEn String
  businessNameAr String?
  crNumber       String       @unique
  vatNumber      String?
  type           SellerType
  country        Country
  city           String
  description    String?      @db.Text
  descriptionAr  String?      @db.Text
  logo           String?
  banner         String?
  tier           SellerTier   @default(STANDARD)
  status         SellerStatus @default(PENDING_REVIEW)
  commissionRate Decimal      @default(5.00) @db.Decimal(5, 2)
  bankDetails    Json?
  rating         Decimal?     @db.Decimal(3, 2)
  reviewCount    Int          @default(0)
  accountHealth  Int          @default(100)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  user            User             @relation(fields: [userId], references: [id])
  products        Product[]
  documents       SellerDocument[]
  payouts         SellerPayout[]
  warehouses      Warehouse[]
  rfqRequests     RFQRequest[]
  messageThreads  MessageThread[]
  sellerCustomers SellerCustomer[]
  commissions     Commission[]
  auditLogs       AuditLog[]
  shipments       Shipment[]
  returnRequests  ReturnRequest[]
  savedViews      SavedView[]
  sellerMemberships SellerMembership[]
  financialAdjustments SellerFinancialAdjustment[]

  @@index([status])
  @@index([country])
}

/// Persisted filter/sort presets a seller saves per list view (orders, products).
/// `query` stores a URL query string (e.g. "status=PROCESSING") applied on click.
model SavedView {
  id        String   @id @default(cuid())
  sellerId  String
  entity    String
  name      String
  query     String
  createdAt DateTime @default(now())

  seller SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, entity])
}

model SellerDocument {
  id              String         @id @default(cuid())
  sellerId        String
  type            DocumentType
  fileUrl         String
  fileName        String
  fileSize        Int?
  mimeType        String?
  status          DocumentStatus @default(PENDING_REVIEW)
  expiryDate      DateTime?
  rejectionReason String?
  uploadedAt      DateTime       @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?

  seller SellerProfile @relation(fields: [sellerId], references: [id])

  @@index([sellerId, status])
  @@index([expiryDate])
}

model SellerPayout {
  id          String       @id @default(cuid())
  sellerId    String
  amount      Decimal      @db.Decimal(12, 2)
  currency    Currency
  status      PayoutStatus @default(PENDING)
  reference   String?
  periodFrom  DateTime
  periodTo    DateTime
  processedAt DateTime?
  notes       String?
  createdAt   DateTime     @default(now())

  seller SellerProfile      @relation(fields: [sellerId], references: [id])
  items  SellerPayoutItem[]

  @@index([sellerId, status])
}

model SellerPayoutItem {
  id         String  @id @default(cuid())
  payoutId   String
  orderId    String
  amount     Decimal @db.Decimal(12, 2)
  commission Decimal @db.Decimal(12, 2)
  net        Decimal @db.Decimal(12, 2)

  payout SellerPayout @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  order  Order        @relation(fields: [orderId], references: [id])

  @@index([payoutId])
  @@index([orderId])
}

// ─── CATALOG ──────────────────────────────────────────────────────────────────

model Category {
  id        String   @id @default(cuid())
  nameEn    String
  nameAr    String
  slug      String   @unique
  parentId  String?
  imageUrl  String?
  iconName  String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([slug])
  @@index([parentId])
}

model Brand {
  id        String   @id @default(cuid())
  nameEn    String
  nameAr    String?
  slug      String   @unique
  logoUrl   String?
  country   Country?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  products Product[]

  @@index([slug])
}

model Product {
  id            String        @id @default(cuid())
  sellerId      String
  categoryId    String
  brandId       String?
  sku           String        @unique
  slug          String        @unique
  nameEn        String
  nameAr        String
  descriptionEn String?       @db.Text
  descriptionAr String?       @db.Text
  status        ProductStatus @default(DRAFT)
  isB2CEnabled  Boolean       @default(false)
  isB2BEnabled  Boolean       @default(true)
  origin        Country?
  weight        Decimal?      @db.Decimal(10, 3)
  dimensions    Json?
  tags          String[]
  moq           Int           @default(1)
  listingHealth Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  publishedAt   DateTime?

  seller           SellerProfile               @relation(fields: [sellerId], references: [id])
  category         Category                    @relation(fields: [categoryId], references: [id])
  brand            Brand?                      @relation(fields: [brandId], references: [id])
  images           ProductImage[]
  variants         ProductVariant[]
  prices           ProductPrice[]
  compliance       ProductComplianceDocument[]
  issues           ProductIssue[]
  healthSnaps      ListingHealthSnapshot[]
  orderItems       OrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
  cartItems        CartItem[]
  inventory        InventoryStock[]
  rfqItems         RFQItem[]
  requisitionItems RequisitionListItem[]
  reviews          ProductReview[]
  commercialMetadata ProductCommercialMetadata?
  externalProductLinks ExternalProductLink[]
  availabilitySnapshots AvailabilitySnapshot[]

  @@index([sellerId, status])
  @@index([categoryId])
  @@index([brandId])
  @@index([slug])
  @@index([sku])
  @@index([deletedAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  altEn     String?
  altAr     String?
  isPrimary Boolean @default(false)
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  sku        String  @unique
  nameEn     String
  nameAr     String?
  attributes Json
  isActive   Boolean @default(true)

  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  prices    ProductPrice[]
  inventory InventoryStock[]
  purchaseOrderItems PurchaseOrderItem[]
  availabilitySnapshots AvailabilitySnapshot[]

  @@index([productId])
}

model ProductPrice {
  id        String      @id @default(cuid())
  productId String?
  variantId String?
  type      PricingType
  currency  Currency    @default(AED)
  minQty    Int         @default(1)
  maxQty    Int?
  price     Decimal     @db.Decimal(12, 2)
  vatRate   Decimal     @default(5.00) @db.Decimal(5, 2)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())

  product Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId, type, currency])
  @@index([variantId])
}

model ProductComplianceDocument {
  id              String         @id @default(cuid())
  productId       String
  sellerId        String
  type            DocumentType
  fileUrl         String
  fileName        String
  issuingBody     String?
  certificateNo   String?
  validFrom       DateTime?
  validUntil      DateTime?
  countries       Country[]
  status          DocumentStatus @default(PENDING_REVIEW)
  rejectionReason String?
  createdAt       DateTime       @default(now())
  reviewedAt      DateTime?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, status])
  @@index([sellerId])
}

model ProductIssue {
  id         String           @id @default(cuid())
  productId  String
  issueType  ProductIssueType
  severity   IssueSeverity    @default(WARNING)
  message    String
  messageAr  String?
  resolvedAt DateTime?
  createdAt  DateTime         @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, resolvedAt])
}

model ListingHealthSnapshot {
  id             String   @id @default(cuid())
  productId      String
  score          Int
  hasImages      Boolean
  hasArabicTitle Boolean
  hasArabicDesc  Boolean
  hasPrice       Boolean
  hasStock       Boolean
  hasCompliance  Boolean
  isApproved     Boolean
  hasBrand       Boolean
  capturedAt     DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, capturedAt])
}

// ─── WAREHOUSE / INVENTORY ────────────────────────────────────────────────────

model Warehouse {
  id        String        @id @default(cuid())
  sellerId  String?
  nameEn    String
  nameAr    String?
  type      WarehouseType
  country   Country
  city      String
  address   String?
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  seller    SellerProfile?      @relation(fields: [sellerId], references: [id])
  locations InventoryLocation[]

  @@index([sellerId])
}

model InventoryLocation {
  id          String  @id @default(cuid())
  warehouseId String
  code        String
  zone        String?
  aisle       String?
  bin         String?
  isActive    Boolean @default(true)

  warehouse Warehouse        @relation(fields: [warehouseId], references: [id])
  stock     InventoryStock[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
}

model InventoryStock {
  id           String   @id @default(cuid())
  productId    String?
  variantId    String?
  locationId   String
  qty          Int      @default(0)
  reservedQty  Int      @default(0)
  reorderPoint Int      @default(10)
  updatedAt    DateTime @updatedAt

  product   Product?            @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location  InventoryLocation   @relation(fields: [locationId], references: [id])
  movements InventoryMovement[]

  @@index([productId])
  @@index([variantId])
  @@index([locationId])
}

model InventoryMovement {
  id        String                @id @default(cuid())
  stockId   String
  type      InventoryMovementType
  qty       Int
  reference String?
  notes     String?
  createdBy String?
  createdAt DateTime              @default(now())

  stock InventoryStock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@index([stockId])
  @@index([createdAt])
}

// ─── CART ─────────────────────────────────────────────────────────────────────

model Cart {
  id        String   @id @default(cuid())
  userId    String?  @unique
  sessionId String?  @unique
  currency  Currency @default(AED)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user  User?      @relation(fields: [userId], references: [id])
  items CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  variantId String?
  qty       Int
  priceAED  Decimal  @db.Decimal(12, 2)
  addedAt   DateTime @default(now())

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@index([productId])
}

// ─── ADDRESS & ORDER ──────────────────────────────────────────────────────────

model Address {
  id         String   @id @default(cuid())
  userId     String?
  companyId  String?
  label      String
  line1      String
  line2      String?
  city       String
  country    Country
  postalCode String?
  lat        Decimal? @db.Decimal(10, 8)
  lng        Decimal? @db.Decimal(11, 8)
  isDefault  Boolean  @default(false)

  user    User?    @relation(fields: [userId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])
  orders  Order[]

  @@index([userId])
  @@index([companyId])
}

model Order {
  id              String          @id @default(cuid())
  orderNumber     String          @unique
  userId          String
  companyId       String?
  purchaseOrderId String?
  addressId       String?
  type            OrderType
  status          OrderStatus     @default(PENDING_PAYMENT)
  fulfillment     FulfillmentType @default(SELLER_FULFILLED)
  currency        Currency        @default(AED)
  subtotal        Decimal         @db.Decimal(12, 2)
  vatAmount       Decimal         @db.Decimal(12, 2)
  shippingAmount  Decimal         @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal         @default(0) @db.Decimal(12, 2)
  total           Decimal         @db.Decimal(12, 2)
  paymentMethod   PaymentMethod?
  paymentStatus   PaymentStatus   @default(UNPAID)
  shippingAddress Json
  notes           String?
  vatInvoiceUrl   String?
  // Client-supplied Idempotency-Key: retries of the same submission return
  // the original order instead of creating a duplicate.
  idempotencyKey  String?
  // SHA-256 of canonical request semantics; never stores address or notes again.
  requestFingerprint String? @db.VarChar(64)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user           User                 @relation(fields: [userId], references: [id])
  company        Company?             @relation(fields: [companyId], references: [id])
  purchaseOrder  PurchaseOrder?       @relation(fields: [purchaseOrderId], references: [id])
  address        Address?             @relation(fields: [addressId], references: [id])
  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  payments       Payment[]
  commissions    Commission[]
  payoutItems    SellerPayoutItem[]
  refunds        Refund[]
  financialAdjustments SellerFinancialAdjustment[]
  taxInvoice     TaxInvoice?
  shipments      Shipment[]
  returnRequests ReturnRequest[]
  integrationStates OrderIntegrationState[]

  @@unique([userId, idempotencyKey])
  @@index([userId, status])
  @@index([companyId])
  @@index([purchaseOrderId])
  @@index([addressId])
  @@index([orderNumber])
  @@index([createdAt])
}

model OrderItem {
  id        String      @id @default(cuid())
  orderId   String
  productId String
  variantId String?
  sellerId  String
  sku       String
  nameEn    String
  nameAr    String
  quantity  Int
  unitPrice Decimal     @db.Decimal(12, 2)
  vatRate   Decimal     @default(5.00) @db.Decimal(5, 2)
  vatAmount Decimal     @db.Decimal(12, 2)
  total     Decimal     @db.Decimal(12, 2)
  status    OrderStatus @default(CONFIRMED)
  createdAt DateTime    @default(now())

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
  returnItems ReturnRequestItem[]

  @@index([orderId])
  @@index([productId])
  @@index([sellerId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  message   String?
  messageAr String?
  actorId   String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ─── PAYMENT / FINANCE ────────────────────────────────────────────────────────

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  method      PaymentMethod
  status      PaymentStatus @default(UNPAID)
  amount      Decimal       @db.Decimal(12, 2)
  currency    Currency
  gatewayRef  String?
  gatewayData Json?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Refund {
  id          String       @id @default(cuid())
  orderId     String
  returnRequestId String?  @unique
  amount      Decimal      @db.Decimal(12, 2)
  netAmount   Decimal      @default(0) @db.Decimal(12, 2)
  vatAmount   Decimal      @default(0) @db.Decimal(12, 2)
  reason      String?
  status      RefundStatus @default(PENDING)
  processedAt DateTime?
  gatewayRef   String?      @unique
  createdAt   DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  returnRequest ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)
  adjustments SellerFinancialAdjustment[]

  @@index([orderId])
}

/// Negative seller receivable created when a completed buyer refund cannot be
/// netted from an unpaid payout (for example, the original payout is PAID).
model SellerFinancialAdjustment {
  id        String                          @id @default(cuid())
  sellerId  String
  orderId   String
  refundId  String
  amount    Decimal                         @db.Decimal(12, 2)
  currency  Currency
  status    SellerFinancialAdjustmentStatus @default(OPEN)
  reason    String
  createdAt DateTime                        @default(now())
  appliedAt DateTime?

  seller SellerProfile @relation(fields: [sellerId], references: [id])
  order  Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refund Refund        @relation(fields: [refundId], references: [id], onDelete: Cascade)

  @@unique([refundId, sellerId])
  @@index([sellerId, status])
  @@index([orderId])
}

model Commission {
  id        String    @id @default(cuid())
  sellerId  String
  orderId   String
  amount    Decimal   @db.Decimal(12, 2)
  rate      Decimal   @db.Decimal(5, 2)
  currency  Currency
  settledAt DateTime?
  createdAt DateTime  @default(now())

  seller SellerProfile @relation(fields: [sellerId], references: [id])
  order  Order         @relation(fields: [orderId], references: [id])

  @@index([sellerId])
  @@index([orderId])
}

model TaxInvoice {
  id          String   @id @default(cuid())
  orderId     String   @unique
  invoiceNo   String   @unique
  fileUrl     String?
  issuedAt    DateTime @default(now())
  totalAmount Decimal  @db.Decimal(12, 2)
  vatAmount   Decimal  @db.Decimal(12, 2)
  currency    Currency

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ─── RFQ ──────────────────────────────────────────────────────────────────────

model RFQRequest {
  id          String    @id @default(cuid())
  rfqNumber   String    @unique
  buyerId     String
  companyId   String?
  sellerId    String?
  status      RFQStatus @default(DRAFT)
  currency    Currency  @default(AED)
  notes       String?
  totalQuoted Decimal?  @db.Decimal(12, 2)
  quoteVersion Int      @default(0)
  requiredBy  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company  Company?       @relation(fields: [companyId], references: [id])
  seller   SellerProfile? @relation(fields: [sellerId], references: [id])
  items    RFQItem[]
  messages Message[]

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([companyId])
}

model RFQItem {
  id         String   @id @default(cuid())
  rfqId      String
  productId  String?
  nameEn     String
  quantity   Int
  unitQuoted Decimal? @db.Decimal(12, 2)
  notes      String?

  rfq     RFQRequest @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  product Product?   @relation(fields: [productId], references: [id])

  @@index([rfqId])
  @@index([productId])
}

// ─── MESSAGING ────────────────────────────────────────────────────────────────

model MessageThread {
  id              String    @id @default(cuid())
  sellerId        String
  buyerId         String
  rfqId           String?
  orderId         String?
  subject         String?
  isOpen          Boolean   @default(true)
  firstResponseAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  seller   SellerProfile @relation(fields: [sellerId], references: [id])
  messages Message[]

  @@index([sellerId])
  @@index([buyerId])
}

model Message {
  id          String            @id @default(cuid())
  threadId    String?
  rfqId       String?
  senderId    String
  senderType  MessageSenderType
  body        String            @db.Text
  attachments String[]
  isRead      Boolean           @default(false)
  readAt      DateTime?
  createdAt   DateTime          @default(now())

  thread MessageThread? @relation(fields: [threadId], references: [id])
  rfq    RFQRequest?    @relation(fields: [rfqId], references: [id])
  sender User           @relation("SentMessages", fields: [senderId], references: [id])

  @@index([threadId])
  @@index([rfqId])
  @@index([senderId])
}

// ─── CRM ──────────────────────────────────────────────────────────────────────

model SellerCustomer {
  id          String    @id @default(cuid())
  sellerId    String
  buyerId     String
  totalOrders Int       @default(0)
  totalSpent  Decimal   @default(0) @db.Decimal(12, 2)
  currency    Currency  @default(AED)
  lastOrderAt DateTime?
  tags        String[]
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  seller     SellerProfile      @relation(fields: [sellerId], references: [id])
  activities CustomerActivity[]

  @@unique([sellerId, buyerId])
  @@index([sellerId])
}

model CustomerActivity {
  id               String   @id @default(cuid())
  sellerCustomerId String?
  buyerId          String
  type             String
  productId        String?
  orderId          String?
  metadata         Json?
  createdAt        DateTime @default(now())

  sellerCustomer SellerCustomer? @relation(fields: [sellerCustomerId], references: [id])
  buyer          User            @relation(fields: [buyerId], references: [id])

  @@index([buyerId])
  @@index([sellerCustomerId])
}

// ─── B2B REQUISITION LISTS ────────────────────────────────────────────────────

model RequisitionList {
  id        String   @id @default(cuid())
  companyId String
  ownerId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   RequisitionListItem[]

  @@index([companyId])
}

model RequisitionListItem {
  id        String   @id @default(cuid())
  listId    String
  productId String?
  sku       String
  nameEn    String
  qty       Int      @default(1)
  unitPrice Decimal? @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  list    RequisitionList @relation(fields: [listId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id])

  @@index([listId])
  @@index([productId])
}

model ProductReview {
  id         String   @id @default(cuid())
  productId  String
  userId     String
  rating     Int
  title      String?
  body       String?  @db.Text
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
}

model SupportTicket {
  id           String          @id @default(cuid())
  ticketNumber String          @unique
  userId       String
  subject      String
  category     String          @default("OTHER")
  priority     SupportPriority @default(NORMAL)
  status       SupportStatus   @default(OPEN)
  description  String          @db.Text
  orderRef     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

// ─── FULFILMENT: SHIPMENTS & RETURNS ──────────────────────────────────────────

model Shipment {
  id             String         @id @default(cuid())
  shipmentNumber String         @unique
  orderId        String
  sellerId       String
  carrier        String?
  trackingNumber String?
  status         ShipmentStatus @default(PENDING)
  promisedBy     DateTime?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  order  Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller SellerProfile   @relation(fields: [sellerId], references: [id])
  events ShipmentEvent[]

  @@index([orderId])
  @@index([sellerId])
  @@index([status])
}

model ShipmentEvent {
  id         String         @id @default(cuid())
  shipmentId String
  status     ShipmentStatus
  location   String?
  note       String?
  createdAt  DateTime       @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

model ReturnRequest {
  id           String       @id @default(cuid())
  returnNumber String       @unique
  orderId      String
  sellerId     String
  reason       String
  status       ReturnStatus @default(REQUESTED)
  refundAmount Decimal?     @db.Decimal(12, 2)
  resolution   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  order  Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller SellerProfile @relation(fields: [sellerId], references: [id])
  items  ReturnRequestItem[]
  refund Refund?

  @@index([orderId])
  @@index([sellerId])
  @@index([status])
}

/// Immutable commercial and tax allocation for each customer-selected returned
/// order line. This is the source of truth for partial refund ledger reversals.
model ReturnRequestItem {
  id              String  @id @default(cuid())
  returnRequestId String
  orderItemId     String
  quantity        Int
  netAmount       Decimal @db.Decimal(12, 2)
  vatAmount       Decimal @db.Decimal(12, 2)
  grossAmount     Decimal @db.Decimal(12, 2)
  createdAt       DateTime @default(now())

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])
}

// ─── NOTIFICATIONS & AUDIT ────────────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  titleEn   String
  titleAr   String?
  bodyEn    String
  bodyAr    String?
  isRead    Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}

model AuditLog {
  id         String      @id @default(cuid())
  actorId    String?
  sellerId   String?
  entityType String
  entityId   String
  action     AuditAction
  before     Json?
  after      Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())

  actor  User?          @relation(fields: [actorId], references: [id])
  seller SellerProfile? @relation(fields: [sellerId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([sellerId])
  @@index([createdAt])
}


// ─── COMMERCE CONTROL PLANE / PILOT OVERHAUL

/// Explicit organization membership for seller users. SELLER_STAFF is no longer
/// treated as an owner-only alias; authorization resolves through this table.
model SellerMembership {
  id          String   @id @default(cuid())
  sellerId    String
  userId      String   @unique
  title       String?
  permissions String[] @default([])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seller SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sellerId, isActive])
}

/// Industrial/B2B attributes supplied by ERP/catalog sources. Product remains
/// merchandising-facing; this record preserves source identifiers and commercial
/// provenance without hiding them in free text or generic tags.
model ProductCommercialMetadata {
  id                     String   @id @default(cuid())
  productId              String   @unique
  sourceSystem           String   @default("CATALOG_IMPORT")
  sourceSheet            String?
  sourceRow              Int?
  erpCode                String?
  externalItemNumber     String?
  manufacturerPartNumber String?
  supplierPartNumber     String?
  uom                    String?
  purchaseUom            String?
  moqPurchase            Int?
  deliveryLeadTimeDays   Int?
  leadTimeText           String?
  hsCode                 String?
  incoterms              String?
  purchasePrice          Decimal? @db.Decimal(14, 4)
  purchaseCurrencyCode   String?
  landedCost             Decimal? @db.Decimal(14, 4)
  packQty                Int?
  palletQty              Int?
  vendorCode             String?
  vendorLegalName        String?
  productGroup           String?
  sourcePayload          Json?
  sourceFingerprint      String
  observedAt             DateTime @default(now())
  updatedAt              DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([erpCode])
  @@index([manufacturerPartNumber])
  @@index([externalItemNumber])
  @@index([sourceSystem, observedAt])
}

/// Platform/client-admin governed promotion definition. Eligibility is a typed
/// JSON policy envelope (seller/company/product/category/brand/territory/segment)
/// so checkout evaluates one canonical policy rather than scattered coupon logic.
model CommercePromotion {
  id                  String   @id @default(cuid())
  tenantKey           String   @default("default")
  name                String
  description         String?
  type                String
  status              String   @default("DRAFT")
  scope               String   @default("PLATFORM")
  sellerId            String?
  companyId           String?
  currency            Currency?
  value               Decimal  @db.Decimal(14, 4)
  minOrderAmount      Decimal? @db.Decimal(14, 2)
  maxDiscountAmount   Decimal? @db.Decimal(14, 2)
  usageLimit          Int?
  perCustomerLimit    Int?
  stackable           Boolean  @default(false)
  priority            Int      @default(100)
  eligibility         Json?
  campaignBudget      Decimal? @db.Decimal(14, 2)
  accountingTreatment String?
  startsAt            DateTime?
  endsAt              DateTime?
  createdById         String?
  approvedById        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tenantKey, status, startsAt, endsAt])
  @@index([sellerId])
  @@index([companyId])
}

model PromotionCoupon {
  id               String   @id @default(cuid())
  promotionId      String
  code             String   @unique
  status           String   @default("ACTIVE")
  usageLimit       Int?
  perCustomerLimit Int?
  startsAt         DateTime?
  endsAt           DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([promotionId, status])
}

model PromotionRedemption {
  id             String   @id @default(cuid())
  promotionId    String
  couponId       String?
  userId         String
  companyId      String?
  orderId        String
  discountAmount Decimal  @db.Decimal(14, 2)
  currency       Currency
  createdAt      DateTime @default(now())

  @@unique([promotionId, orderId])
  @@index([couponId, userId])
  @@index([companyId])
}

model ReferralProgram {
  id               String   @id @default(cuid())
  tenantKey        String   @default("default")
  name             String
  status           String   @default("DRAFT")
  referrerRewardType String
  referrerRewardValue Decimal @db.Decimal(14, 4)
  refereeRewardType String
  refereeRewardValue Decimal @db.Decimal(14, 4)
  currency         Currency?
  maxUsesPerCode   Int?
  startsAt         DateTime?
  endsAt           DateTime?
  eligibility      Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenantKey, status])
}

model ReferralCode {
  id        String   @id @default(cuid())
  programId String
  ownerUserId String
  code      String   @unique
  isActive  Boolean  @default(true)
  uses      Int      @default(0)
  createdAt DateTime @default(now())

  @@index([programId, ownerUserId])
}

model ReferralAttribution {
  id             String   @id @default(cuid())
  referralCodeId String
  referredUserId String
  orderId        String?
  status         String   @default("ATTRIBUTED")
  rewardAmount   Decimal? @db.Decimal(14, 2)
  currency       Currency?
  createdAt      DateTime @default(now())
  rewardedAt     DateTime?

  @@unique([referralCodeId, referredUserId])
  @@index([orderId])
}

/// One canonical integration registry for Dynamics 365, SAP, generic ERP/WMS/PIM
/// and future systems. credentialsRef stores a secret-manager reference only.
model IntegrationConnection {
  id                String   @id @default(cuid())
  tenantKey         String   @default("default")
  system            String
  connectionKey     String
  name              String
  status            String   @default("DISABLED")
  baseUrl           String?
  credentialsRef    String?
  settings          Json?
  lastHealthCheckAt DateTime?
  lastSuccessAt     DateTime?
  lastFailureAt     DateTime?
  lastError         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  outboxMessages    IntegrationOutbox[]
  companyRoutes     IntegrationCompanyRoute[]

  @@unique([tenantKey, system, connectionKey])
  @@index([tenantKey, status])
}

/// Explicit outbound routing. Multiple rows are representable so corrupted or
/// overlapping governance fails closed in the resolver instead of silently
/// selecting one connection by timestamp.
model IntegrationCompanyRoute {
  id           String   @id @default(cuid())
  tenantKey    String   @default("default")
  companyId    String
  connectionId String
  purpose      String   @default("ORDER_SUBMISSION")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company    Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  connection IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  @@unique([tenantKey, companyId, connectionId, purpose])
  @@index([tenantKey, companyId, purpose])
  @@index([connectionId])
}

model ExternalAccountLink {
  id                 String   @id @default(cuid())
  tenantKey          String   @default("default")
  companyId          String
  system             String
  externalCustomerId String
  salesArea          String?
  priceGroup         String?
  metadata           Json?
  lastSyncedAt       DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  company            Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([tenantKey, companyId, system])
  @@index([system, externalCustomerId])
}

model ExternalProductLink {
  id                String   @id @default(cuid())
  tenantKey         String   @default("default")
  productId         String
  system            String
  externalProductId String
  externalSku       String?
  metadata          Json?
  lastSyncedAt      DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  product           Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantKey, productId, system])
  @@index([system, externalProductId])
}

/// Short-lived source observations. These are evidence, not a second inventory
/// ledger: checkout must revalidate stale/unknown availability before acceptance.
model AvailabilitySnapshot {
  id             String   @id @default(cuid())
  tenantKey      String   @default("default")
  productId      String
  variantId      String?
  warehouseCode  String?
  sourceSystem   String
  state          String
  availableQty   Int?
  reservedQty    Int?
  expectedRestockAt DateTime?
  provenance     Json?
  observedAt     DateTime @default(now())
  expiresAt      DateTime
  product        Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant        ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([tenantKey, productId, observedAt])
  @@index([expiresAt])
}

/// Immutable evidence of the commercial answer used for a customer/quantity.
model CommercialPriceSnapshot {
  id              String   @id @default(cuid())
  tenantKey       String   @default("default")
  productId       String
  variantId       String?
  companyId       String?
  source          String
  sourceSystem    String?
  sourceReference String?
  currency        Currency
  quantity        Int
  unitPrice       Decimal  @db.Decimal(14, 4)
  explanation     Json
  validFrom       DateTime?
  validUntil      DateTime?
  observedAt      DateTime @default(now())

  @@index([tenantKey, productId, companyId, currency, observedAt])
}

/// Transactional outbox/inbox makes ERP submission retryable and idempotent.
model IntegrationOutbox {
  id             String   @id @default(cuid())
  tenantKey      String   @default("default")
  aggregateType  String
  aggregateId    String
  eventType      String
  destination    String
  connectionId   String?
  payload        Json
  idempotencyKey String   @unique
  status         String   @default("PENDING")
  attempts       Int      @default(0)
  nextAttemptAt  DateTime?
  leaseOwner     String?
  leaseExpiresAt DateTime?
  fencingToken   Int      @default(0)
  lastError      String?
  createdAt      DateTime @default(now())
  processedAt    DateTime?
  connection     IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt, createdAt])
  @@index([status, leaseExpiresAt])
  @@index([aggregateType, aggregateId])
  @@index([connectionId])
}

model IntegrationInbox {
  id              String   @id @default(cuid())
  tenantKey       String   @default("default")
  source          String
  externalEventId String
  eventType       String
  payload         Json
  status          String   @default("RECEIVED")
  attempts        Int      @default(0)
  nextAttemptAt   DateTime?
  leaseOwner      String?
  leaseExpiresAt  DateTime?
  fencingToken    Int      @default(0)
  receivedAt      DateTime @default(now())
  processedAt     DateTime?
  lastError       String?

  @@unique([tenantKey, source, externalEventId])
  @@index([status, receivedAt])
  @@index([status, nextAttemptAt, leaseExpiresAt])
}

/// ERP acceptance is separate from the marketplace order status so the UI can
/// never imply that a locally-created order has been accepted by the ERP.
model OrderIntegrationState {
  id                  String   @id @default(cuid())
  tenantKey           String   @default("default")
  orderId             String
  system              String
  state               String   @default("PENDING_VALIDATION")
  externalOrderId     String?
  correlationId       String?
  lastValidatedAt     DateTime?
  lastAttemptAt       DateTime?
  acceptedAt          DateTime?
  rejectedAt          DateTime?
  rejectionReason     String?
  authoritativeTotals Json?
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())
  order               Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([tenantKey, orderId, system])
  @@index([state, updatedAt])
}

/// Reconstructable line-level pricing explanation for support, finance and audit.
model IntegrationWorkerHealth {
  workerId        String   @id
  startedAt       DateTime
  lastHeartbeatAt DateTime
  lastClaimAt     DateTime?
  lastSuccessAt   DateTime?
  lastFailureAt   DateTime?
  lastError       String?
  processedCount  Int      @default(0)
  failedCount     Int      @default(0)
  metadata        Json?
  updatedAt       DateTime @updatedAt

  @@index([lastHeartbeatAt])
}

model OrderLinePriceTrace {
  id                String   @id @default(cuid())
  orderItemId       String   @unique
  currency          Currency
  listPrice         Decimal? @db.Decimal(14, 4)
  contractPrice     Decimal? @db.Decimal(14, 4)
  volumeAdjustment  Decimal  @default(0) @db.Decimal(14, 4)
  promotionDiscount Decimal  @default(0) @db.Decimal(14, 4)
  couponDiscount    Decimal  @default(0) @db.Decimal(14, 4)
  referralCredit    Decimal  @default(0) @db.Decimal(14, 4)
  finalUnitPrice    Decimal  @db.Decimal(14, 4)
  sourceSystem      String?
  explanation       Json
  validatedAt       DateTime @default(now())
}


// ─── GOVERNED PURCHASE ORDER LINES

/// Immutable commercial snapshot of what a company actually submitted for
/// approval. Placement revalidates current price and stock, but this line remains
/// the evidence of what was approved and why.
model PurchaseOrderItem {
  id              String   @id @default(cuid())
  purchaseOrderId String
  productId       String
  variantId       String?
  sellerId        String
  sku             String
  nameEn          String
  quantity        Int
  unitPrice       Decimal  @db.Decimal(14, 4)
  vatRate         Decimal  @db.Decimal(5, 2)
  lineSubtotal    Decimal  @db.Decimal(14, 2)
  priceSourceId   String?
  priceExplanation Json?
  createdAt       DateTime @default(now())

  purchaseOrder PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product         @relation(fields: [productId], references: [id])
  variant       ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
  @@index([sellerId])
}
