{
  "name": "@avenick/database",
  "version": "1.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./commerce-governance": "./src/services/commerce-governance.ts",
    "./pilot-catalog": "./src/services/pilot-catalog.ts",
    "./testing": "./src/testing/integration-db.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:manifest": "node scripts/write-migration-manifest.mjs",
    "db:push": "node scripts/refuse-destructive.mjs db:push",
    "db:push:DANGEROUS": "node scripts/require-ack.mjs && prisma db push",
    "db:deploy": "bash scripts/migrate-deploy.sh",
    "db:deploy:vercel": "bash scripts/migrate-deploy-vercel.sh",
    "db:migrate": "node scripts/refuse-destructive.mjs db:migrate",
    "db:migrate:DANGEROUS": "node scripts/require-ack.mjs && prisma migrate dev",
    "db:migrate:prod": "bash scripts/migrate-deploy.sh",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:certification": "tsx prisma/seed-certification.ts",
    "db:enrich:demo-products": "tsx prisma/enrich-demo-products.ts",
    "db:provision:industrial-demo": "tsx prisma/provision-industrial-demo.ts",
    "db:import-pilot": "tsx prisma/import-pilot-catalog.ts",
    "demo:reviews": "node scripts/demo-reviews.mjs",
    "demo:brand-logos": "node scripts/demo-brand-logos.mjs",
    "db:studio": "prisma studio",
    "db:reset": "node scripts/refuse-destructive.mjs db:reset",
    "db:reset:DANGEROUS": "node scripts/require-ack.mjs && prisma migrate reset --force",
    "integration:worker": "tsx scripts/integration-worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:personas": "node prisma/verify-seed-personas.mjs"
  },
  "dependencies": {
    "@avenick/observability": "workspace:*",
    "@avenick/utils": "workspace:*",
    "@noble/hashes": "1.7.1",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
