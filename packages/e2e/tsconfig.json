{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "cypress"]
  },
  "include": [
    "playwright.config.ts",
    "cypress.config.ts",
    "targets.d.ts",
    "playwright/**/*.ts",
    "cypress/**/*.ts"
  ],
  "exclude": ["node_modules", "artifacts"]
}
