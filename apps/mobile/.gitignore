# Flutter build output and tooling state.
#
# This file did not exist, so `.dart_tool/` — 17 files of package resolution and
# build-graph state regenerated by every `flutter pub get` — was staged along
# with the app's source on the first commit that touched this directory.
#
# `lib/theme/tokens.g.dart` is deliberately NOT ignored. It is generated, but it
# is generated by @avenick/design-tokens from the same CSS custom properties the
# three web portals read, and committing it is what lets the Flutter app build
# without running the token pipeline first.

.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
*.iml
.idea/
.DS_Store
