{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "cd ../.. && pnpm db:generate && pnpm turbo run build --filter=@avenick/customer",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://avenick-commerce.onrender.com/api/$1"
    }
  ]
}
