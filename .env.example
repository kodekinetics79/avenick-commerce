# ── Database ─────────────────────────────────────────────────────────────────
# Local dev (docker-compose): both URLs point at the same Postgres.
DATABASE_URL="postgresql://avenick:avenick@localhost:5432/avenick?schema=public"
DIRECT_URL="postgresql://avenick:avenick@localhost:5432/avenick?schema=public"
#
# Neon (production on Vercel):
#   DATABASE_URL = the *pooled* connection string (…-pooler.neon.tech)
#   DIRECT_URL   = the *direct* connection string (used by prisma migrate)
# Both are shown in the Neon dashboard / Vercel integration env vars.

# ── Shared rate-limit + read-cache store (Upstash Redis over REST) ───────────
# These two names are the ONLY ones any code reads
# (packages/auth/src/redis-rate-limit-store.ts, packages/database/src/redis-cache-store.ts).
# With either unset, installRedisRateLimitStore()/installRedisCacheStore() return
# false and every portal instance keeps a private in-memory map: throttle counts
# and cached reads are not shared between instances and are lost on restart. That
# is single-instance behaviour only — set both before any multi-instance rollout.
#
# Left COMMENTED deliberately. Unlike the inert placeholders further down, these
# two are load-bearing the moment they are non-empty: installRedisRateLimitStore()
# installs the REST store, and UpstashRestStore.incr() lets a failed fetch throw.
# checkRateLimit() has no catch, so a placeholder host would make every sign-in,
# registration and catalog read throw instead of falling back to in-memory.
# Uncomment only with real Upstash values.
# UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-rest-token"
#
# UNUSED: no code in this repository reads REDIS_URL. It configured nothing and
# is kept here only so nobody sets it again expecting shared rate limiting.
# REDIS_URL="redis://localhost:6379"

# ── Trusted proxy depth for per-IP rate limiting ─────────────────────────────
# X-Forwarded-For is append-only, so its FIRST entry is whatever the client sent.
# clientIpFrom() therefore counts in from the RIGHT. TRUSTED_PROXY_HOPS is how
# many proxies in front of this process append to that header: 1 for Vercel's
# edge and 1 for Render's load balancer, which is the default. Raise it only when
# another appending proxy (CDN, ingress) is added in front — setting it too high
# is safe (the derivation falls back to the rightmost entry), setting it too low
# buckets unrelated clients under one proxy address and throttles real traffic.
TRUSTED_PROXY_HOPS="1"
# Optional: name a header your edge OVERWRITES on every request, used ahead of
# X-Forwarded-For. Set this ONLY if that edge really is in front of every
# request — otherwise a client can send the header itself and forge its IP.
# TRUSTED_CLIENT_IP_HEADER="cf-connecting-ip"

# NextAuth (shared by all 3 portals)
AUTH_SECRET="change-me-in-production-use-openssl-rand-base64-32"
NEXTAUTH_SECRET="change-me-in-production-use-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:13100"

# Checkout.com
# NOTE: the current repo has a signed webhook consumer but does not yet create
# Checkout.com payment sessions. Online card methods therefore fail closed until
# the payment-initiation flow is implemented and certified.
CHECKOUT_PUBLIC_KEY="pk_test_xxxx"
CHECKOUT_SECRET_KEY="sk_test_xxxx"
CHECKOUT_WEBHOOK_SECRET="whsec_xxxx"

# ERP inbound status webhooks terminate on the admin backend. The deployment
# keyring binds one key ID and independent 32+ character secret to one governed
# connection. Sign `<key-id>.<timestamp>.<raw body>` with HMAC-SHA256 and send
# the key ID, timestamp, and hex digest in the `x-avenick-*` headers.
INTEGRATION_WEBHOOK_SIGNING_KEYRING='[{"keyId":"erp-primary","system":"ERP","connectionId":"replace-with-governed-connection-id","secret":"replace-with-32-plus-random-characters"}]'

# Explicit pilot-only simulated payment. BOTH switches must be true for the API
# to accept PaymentMethod.MOCK. Disable both for any paid/live production launch.
PILOT_MODE="false"
ALLOW_MOCK_PAYMENTS="false"
NEXT_PUBLIC_PILOT_MODE="false"

# S3 / MinIO / R2 — browser-direct uploads (product images, seller documents)
# are enabled only when all five S3_* values are set. Must be set on EVERY
# portal deployment (customer, seller, admin), not only the seller: the
# portals allow-list this host for next/image at BUILD time, so a missing
# value renders uploaded product images as a blank catalog.
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="avenick_access"
S3_SECRET_KEY="avenick_secret"
S3_BUCKET="avenick-uploads"
S3_REGION="us-east-1"
# Optional. Public-read origin when it differs from the API endpoint
# (Cloudflare R2 public bucket URL, or a CDN in front of the bucket). Must
# already address the bucket — no bucket segment is appended.
# S3_PUBLIC_BASE_URL="https://pub-xxxx.r2.dev"
# The bucket needs a CORS rule allowing PUT from the seller portal origin with
# the Content-Type header, or browser uploads fail before reaching the app.

# Elasticsearch
ELASTICSEARCH_URL="http://localhost:9200"
ELASTICSEARCH_USERNAME="elastic"
ELASTICSEARCH_PASSWORD="avenick_elastic"

# ── Email (Resend) ───────────────────────────────────────────────────────────
# RESEND_FROM_EMAIL is REQUIRED for any email to send — there is no default
# sender. Read only through emailSender() in @avenick/utils/portal-config, which
# accepts exactly two shapes: "Name <local@host>" or "local@host" (host with a
# dot). Unset or malformed = every transactional email (invites, password
# resets, already-registered notices) refuses to send and logs at error; no
# link is invented and no address is guessed. Use a domain verified in Resend.
RESEND_API_KEY="re_xxxx"
RESEND_FROM_EMAIL=""

# SMS/WhatsApp (Twilio)
TWILIO_ACCOUNT_SID="ACxxxx"
TWILIO_AUTH_TOKEN="xxxx"
TWILIO_WHATSAPP_NUMBER="+14155238886"

# AI assist (seller portal drafts)
ANTHROPIC_API_KEY="sk-ant-xxxx"

# ── Portal origins (public, inlined at BUILD time) ───────────────────────────
# Public origin of each portal: scheme + host (+ port), nothing else. EVERY
# portal needs ALL THREE to build cross-portal links (storefront → "Become a
# seller", seller login → "Forgot password" on the customer portal, links into
# the admin portal) and to address itself in emails. Read only through
# @avenick/utils/portal-config, which accepts "https://host" or "https://host/"
# and rejects a value carrying a path, query or credentials as if it were unset.
#
# Unset in production = the link is hidden and server code that needs the
# origin (password-reset links) refuses rather than inventing a host. When
# NODE_ENV is not "production" an unset value falls back to the dev port below
# (customer 13100, seller 13101, admin 13102). NEXT_PUBLIC_ values are baked in
# at build time: changing one needs a rebuild, not a restart.
NEXT_PUBLIC_CUSTOMER_PORTAL_URL="http://localhost:13100"
NEXT_PUBLIC_SELLER_PORTAL_URL="http://localhost:13101"
NEXT_PUBLIC_ADMIN_PORTAL_URL="http://localhost:13102"
#
# CUSTOMER_URL is still read by apps/customer/src/lib/backend.ts as one of the
# accepted own-origins for incoming requests; NEXT_PUBLIC_CUSTOMER_PORTAL_URL is
# accepted there too, so a deployment can set just the NEXT_PUBLIC_ one.
CUSTOMER_URL="http://localhost:13100"
# UNUSED: no code reads SELLER_URL or ADMIN_URL. Kept commented so nobody sets
# them again expecting cross-portal links — those come from the three
# NEXT_PUBLIC_*_PORTAL_URL values above.
# SELLER_URL="http://localhost:13101"
# ADMIN_URL="http://localhost:13102"

# ── Platform identity + public contact addresses (inlined at BUILD time) ─────
# Shown wherever the platform names itself or offers a way to reach a person:
# footers, legal/privacy pages, transactional email. Each address is validated
# as a bare "local@host"; a malformed value is treated as unset. No default:
# unset = the contact line is omitted, never a made-up address.
# LEGAL and PRIVACY fall back to SUPPORT when unset.
NEXT_PUBLIC_SUPPORT_EMAIL=""
NEXT_PUBLIC_LEGAL_EMAIL=""
NEXT_PUBLIC_PRIVACY_EMAIL=""
# Brand name for titles, subjects and copy. Empty = "Avenick".
NEXT_PUBLIC_PLATFORM_NAME=""
# Storefront default currency when the request names none. One of AED SAR QAR
# KWD OMR BHD; unset or invalid falls back to AED (the launch market). Read by
# server DTOs at runtime and inlined into client bundles at build time, so set
# it in the BUILD environment as well as the runtime one.
NEXT_PUBLIC_DEFAULT_CURRENCY=""

# ── Backend origins (read by each app's lib/backend.ts and next.config.mjs) ──
# The Render service each Vercel frontend forwards its credentialed API calls
# to. EMPTY on purpose: with no value each portal stays same-origin and serves
# its own /api routes, which is what local development wants. A value here is
# the LIVE backend — `cp .env.example .env` must never point a laptop at
# production with the developer's session cookie attached. Set per deployment
# (DEPLOYMENT.md, "Backend URL by project") as https://<your-customer-backend>.
NEXT_PUBLIC_BACKEND_URL=""
NEXT_PUBLIC_SELLER_BACKEND_URL=""
NEXT_PUBLIC_ADMIN_BACKEND_URL=""

# ── Observability (OpenTelemetry) ────────────────────────────────────────────
# When OTEL_EXPORTER_OTLP_ENDPOINT is UNSET, telemetry is disabled and the apps
# run exactly as before (structured logs still go to stdout). Set these three to
# turn on traces + metrics export. Logs remain on stdout and are shipped by the
# platform's log drain (Grafana Cloud / Loki), correlated to traces by trace_id.
#
# Grafana Cloud: create a stack, then in "OpenTelemetry" copy the OTLP endpoint
# and generate an API token. The Authorization header is base64("instanceId:token").
#   OTEL_EXPORTER_OTLP_ENDPOINT="https://otlp-gateway-<region>.grafana.net/otlp"
#   OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic <base64 instanceID:token>"
OTEL_EXPORTER_OTLP_ENDPOINT=""
OTEL_EXPORTER_OTLP_HEADERS=""
# Per-app logical name on every span/metric/log. Each portal overrides this in
# its deploy env (avenick-customer / avenick-seller / avenick-admin).
OTEL_SERVICE_NAME="avenick-customer"
# Minimum log level emitted to stdout: debug | info | warn | error.
LOG_LEVEL="info"

# ── DB resilience (graceful degradation / bypass) ────────────────────────────
# Tunes the database circuit breaker + timeout/retry wrapper. Defaults are sane;
# override only to tighten/loosen for your load. See OBSERVABILITY.md.
DB_TIMEOUT_MS="4000"            # per-attempt query timeout
DB_MAX_ATTEMPTS="3"            # total attempts on transient errors (1 = no retry)
DB_BACKOFF_MS="100"           # base jittered backoff between retries
DB_BREAKER_THRESHOLD="5"      # consecutive failures before the circuit opens
DB_BREAKER_COOLDOWN_MS="10000" # how long the circuit stays open before probing

# ── PII field encryption at rest (data protection) ───────────────────────────
# When unset, sensitive fields are stored as plaintext (dev/pilot). To enable
# app-level AES-256-GCM encryption, provide a JSON keyring and the active key id.
# Generate a key:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotate by adding a new key id and switching ACTIVE_KEY_ID; old values still
# decrypt because their key stays on the ring. See ARCHITECTURE_RESILIENCE.md.
PII_ENCRYPTION_KEYS=""              # e.g. {"k1":"<base64 32-byte key>"}
PII_ENCRYPTION_ACTIVE_KEY_ID=""     # e.g. k1

# ── Backups / DR (used by scripts/backup-database.sh, run as a Render cron) ───
BACKUP_RETENTION_DAYS="14"          # bucket lifecycle prunes db-backups/ after this
BACKUP_PREFIX="db-backups"          # object-storage key prefix for dumps

# Node
NODE_ENV="development"
